# No trailing slash: a git worktree gets its node_modules as a SYMLINK to the
# primary checkout's, and `node_modules/` matches only a directory.
node_modules
coverage/
*.tsbuildinfo

# dist/ is deliberately NOT ignored: it is the committed build artifact a
# consumer gets straight from a git tag, and CI diffs it against a fresh
# `tools/gen.sh` run.
