{
    "name": "@ayaka/design-system",
    "version": "0.5.0",
    "type": "module",
    "private": false,
    "description": "Frontend design schema, voices and primitives for Harry's tool UIs",
    "license": "UNLICENSED",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AyakaRadiology/design-system.git"
    },
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./react": {
            "types": "./dist/react/index.d.ts",
            "default": "./dist/react/index.js"
        },
        "./color": {
            "types": "./dist/color.d.ts",
            "default": "./dist/color.js"
        },
        "./tailwind.css": "./tailwind.css",
        "./voices/*.css": "./voices/*.css",
        "./tokens/*.css": "./tokens/*.css",
        "./tokens/schema.json": "./tokens/schema.json",
        "./package.json": "./package.json"
    },
    "bin": {
        "design-lint": "bin/design-lint.js"
    },
    "files": [
        "dist",
        "tokens",
        "voices",
        "tailwind.css",
        "bin",
        "README.md",
        "AGENTS.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "gen": "tools/gen.sh",
        "typecheck": "tsc --noEmit",
        "lint": "biome check .",
        "test": "vitest run --passWithNoTests",
        "check": "bun run design:check && bun run gen && bun run typecheck && bun run lint && bun run validate-voices && bun run test && bun run design-lint && bun run consumer-smoke && tools/check-dist.sh && bun run storybook:check",
        "design:generate": "bun tools/generate-design.ts",
        "design:check": "bun tools/generate-design.ts --check",
        "validate-voices": "bun tools/validate-voices.ts",
        "design-lint": "node bin/design-lint.js --config design-lint.json",
        "consumer-smoke": "tests/consumer/run.sh",
        "storybook": "storybook dev --host 127.0.0.1 --port 6006 --no-open --exact-port",
        "storybook:build": "storybook build --disable-telemetry",
        "storybook:test": "bun tools/storybook-smoke.ts",
        "storybook:check": "bun run storybook:build && bun run storybook:test"
    },
    "peerDependencies": {
        "react": "^19",
        "react-dom": "^19",
        "tailwindcss": "^4"
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-radio-group": "^1.4.7",
        "@radix-ui/react-select": "^2.3.7",
        "@radix-ui/react-switch": "^1.3.7",
        "@radix-ui/react-tooltip": "^1.2.16",
        "class-variance-authority": "^0.7.1",
        "postcss": "^8.5.28",
        "tailwind-merge": "^3.6.0",
        "typescript": "5.9"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.12",
        "@storybook/addon-docs": "10.6.0",
        "@storybook/addon-mcp": "10.6.0",
        "@storybook/react-vite": "10.6.0",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^26.4.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitest/browser-playwright": "5.0.0",
        "jsdom": "^30.0.1",
        "playwright": "^1.63.0",
        "storybook": "10.6.0",
        "vite": "^8.2.2",
        "vitest": "^5.0.0"
    }
}
